# Python
.venv/
__pycache__/
*.pyc
.ruff_cache/
.pytest_cache/

# Rust
target/

# Obsidian runtime state in the example vault (regenerable / machine-local)
vault/.obsidian/workspace*
vault/.smart-env/
vault/.trash/

# gaiafield's generated graph store — regenerable via `gaiafield index`, never committed
vault/.gaiafield/

# The cheat sheet's intermediate page (docs/cheatsheet/build.py writes it next to the PDF and PNG)
docs/cheatsheet/cheatsheet.html

# Local
.DS_Store
.env
*.local.json

# claude plugin eval run outputs
plugins/*/skill-evals/results/

# Claude Code worktrees of this repo (EnterWorktree, claude -w)
.claude/worktrees/

# The real vault, cloned by scripts/cloud-vault.sh open; never committed here
.vault-live/

# Session records the memory hook writes when TOOLKIT_VAULT is unset: the owner's own sessions,
# never published from this public repo (their home is the real vault)
vault/00_Memory/sessions/
